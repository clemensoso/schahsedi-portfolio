---
import '@fontsource/boldonse/400.css';
import '@fontsource-variable/geist/wght.css';
import '../styles/global.css';
// Schriften früh anfragen, nicht erst nach dem CSS: gleiche Dateien (gleicher Hash) wie in den @font-face-Regeln
import boldonseUrl from '@fontsource/boldonse/files/boldonse-latin-400-normal.woff2?url';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

const { title = 'Schah Sedi', description } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preload" href={boldonseUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <slot />
  </body>
</html>
