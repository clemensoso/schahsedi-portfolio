---
// Rahmen für Unterseiten (Projekte, Playground …): Nav, Inhalt, Footer. Heller Seitenton.
// Overlays (z. B. das Projekt-Overlay) gehören in den Slot „overlay“: Sie müssen direkt im <body> liegen,
// weil das Overlay beim Öffnen alles andere im <body> stilllegt.
import Base from './Base.astro';
import Sprite from '../components/Sprite.astro';
import NavLiquid from '../components/NavLiquid.astro';
import Footer from '../components/Footer.astro';
import '../styles/listing.css';

const { title, description } = Astro.props;
---
<Base title={title} description={description} tone="light">
  <slot name="overlay" />
  <Sprite />
  <NavLiquid />
  <main id="start" class="page">
    <slot />
  </main>
  <Footer />
  <script is:inline>document.getElementById('foot-year').textContent = new Date().getFullYear();</script>
</Base>
