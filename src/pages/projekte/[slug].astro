---
// Jedes Projekt hat eine eigene Adresse. Direkt aufgerufen liegt die Projekt-Sammlung dahinter und das Overlay ist schon offen.
// Aus dem Karussell der Startseite heraus öffnet es sich dagegen über der Startseite (das Overlay lädt nur den Inhalt).
import Page from '../../layouts/Page.astro';
import ProjectOverlay from '../../components/ProjectOverlay.astro';
import ProjectArticle from '../../components/ProjectArticle.astro';
import WorkCollection from '../../components/WorkCollection.astro';
import { projects, projectsIndexUrl } from '../../lib/projects.js';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
---
<Page title={`${project.title} · Schah Sedi`} description={project.intro}>
  <ProjectOverlay slot="overlay" open home={projectsIndexUrl} homeTitle="Projekte · Schah Sedi">
    <ProjectArticle project={project} />
  </ProjectOverlay>
  <WorkCollection initial="projekte" />
</Page>
