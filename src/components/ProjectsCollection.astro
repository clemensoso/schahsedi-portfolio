---
// Sammlung aller Projekte (/projekte/): Kacheln mit Filter nach Bereich.
// Projekte mit eigener Seite öffnen sich im Projekt-Overlay; die übrigen sind reine Kacheln.
import CardStack from './CardStack.astro';
import WorkSwitch from './WorkSwitch.astro';
import { allProjects, projectCategories, projectUrl } from '../lib/projects.js';
---
<section class="listing" aria-labelledby="listing-title">
  <header class="wrap listing-head">
    <WorkSwitch active="projekte" />
    <h1 class="display" id="listing-title">Alle Projekte</h1>
    <p>Branding, Packaging, Editorial und alles dazwischen: eine Auswahl aus den letzten Jahren.</p>
    {projectCategories.length > 1 && (
      <div class="filter" role="group" aria-label="Nach Bereich filtern">
        <button type="button" class="filter-btn" data-filter="" aria-pressed="true">Alle</button>
        {projectCategories.map((c) => <button type="button" class="filter-btn" data-filter={c} aria-pressed="false">{c}</button>)}
      </div>
    )}
  </header>
  <ul class="wrap grid" id="listing-grid">
    {allProjects.map((p) => {
      const meta = [p.year, p.categories.join(', ')].filter(Boolean).join(' · ');
      // Bilder für den Stapel: Cover, dann weitere Bilder aus dem Projekt (ohne Doppelte), höchstens drei
      const pics = [...new Set([p.cover, ...(p.blocks || []).filter((b) => b.type === 'image' && b.image).map((b) => b.image), p.coverMobile].filter(Boolean))];
      const inner = (
        <>
          <span class="card-media"><CardStack images={pics} pos={p.coverPos} /></span>
          <span class="card-text"><b>{p.title}</b>{meta && <small>{meta}</small>}</span>
        </>
      );
      return (
        <li class="card" data-cats={JSON.stringify(p.categories)}>
          {p.hasPage
            ? <a class="card-link" href={projectUrl(p.slug)} data-project={p.slug}>{inner}</a>
            : <div class="card-link is-static">{inner}</div>}
        </li>
      );
    })}
  </ul>
  <p class="wrap listing-empty" id="listing-empty" hidden>In diesem Bereich gibt es noch keine Projekte.</p>
</section>

<script is:inline>(function () {
  // Filter: Kacheln eines Bereichs zeigen; die gewählte Taste ist gedrückt
  var btns = document.querySelectorAll('.listing .filter-btn'), cards = document.querySelectorAll('#listing-grid .card');
  var empty = document.getElementById('listing-empty');
  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      var f = b.dataset.filter, shown = 0;
      btns.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      cards.forEach(function (c) { var on = !f || JSON.parse(c.dataset.cats).indexOf(f) >= 0; c.hidden = !on; if (on) shown++; });
      empty.hidden = shown > 0;
    });
  });
})();</script>
