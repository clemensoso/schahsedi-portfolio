---
import work from '../data/work.json';
import Poster from './Poster.astro';
---
<section class="work" id="arbeiten" data-nav="Projects" aria-labelledby="arbeiten-title">
      <div class="wrap section-head reveal">
        <h2 class="display" id="arbeiten-title">{work.title}</h2>
        <div class="slider-ctrl">
          <button class="arrow-btn prev" type="button" id="prev" aria-label="Vorheriges Projekt" aria-controls="track"><svg aria-hidden="true"><use href="#arrow"/></svg></button>
          <button class="arrow-btn next" type="button" id="next" aria-label="Nächstes Projekt" aria-controls="track"><svg aria-hidden="true"><use href="#arrow"/></svg></button>
        </div>
      </div>

      <div class="slider reveal" id="slider" aria-roledescription="Karussell" aria-label="Ausgewählte Projekte">
        <div class="track" id="track">
          {work.slides.map((s) => (
            <a class="slide" href="#arbeiten" draggable="false" aria-label={s.title}>
              <Poster image={s.image} imageMobile={s.imageMobile} pos={s.pos} />
              <div class="cap"><span class="cap-text"><b>{s.title}</b></span><span class="btn-dot" aria-hidden="true"><svg><use href="#arrow"/></svg></span></div>
            </a>
          ))}
        </div>
        <div class="wrap slider-foot">
          <div class="dots" id="dots"></div>
          <div class="slider-more">
            <p>{work.moreText}</p>
            <a class="btn secondary" href="#arbeiten"><span class="btn-label">{work.moreButton}</span><span class="btn-dot" aria-hidden="true"><svg><use href="#arrow"/></svg></span></a>
          </div>
        </div>
      </div>
    </section>
