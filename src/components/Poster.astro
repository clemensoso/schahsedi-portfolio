---
import { asset } from '../lib/asset.js';
// Projektbild: optional eigenes Hochformat fürs Handy, --pos ist der Bildausschnitt
const { image, imageMobile, pos } = Astro.props;
const style = pos ? `--pos:${pos}` : undefined;
---
<div class="poster">
  {imageMobile ? (
    <picture class="pa"><source media="(max-width: 719px)" srcset={asset(imageMobile)} /><img src={asset(image)} alt="" draggable="false" style={style} /></picture>
  ) : (
    <img class="pa" src={asset(image)} alt="" draggable="false" style={style} />
  )}
</div>
