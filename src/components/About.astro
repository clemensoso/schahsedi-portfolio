---
import { asset } from '../lib/asset.js';
import about from '../data/about.json';
---
<section class="about wrap" id="ueber-mich" data-nav="Personal" aria-labelledby="about-title">
      <div class="about-head center reveal">
        <h2 class="display" id="about-title">{about.titleLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>
        <p>{about.intro}</p>
      </div>
      <div class="bento">
        <div class="tile t-portrait reveal" style="--i:0">
          <div class="portrait-img"><img id="portrait-gif" data-gif={asset(about.portrait.animation)} src={asset(about.portrait.still)} alt={about.portrait.alt} loading="lazy"></div>
          <button class="portrait-play" type="button" id="portrait-play" aria-pressed="false" aria-label="Animation abspielen"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.8c0-.8.9-1.3 1.6-.9l7.3 4.9c.6.4.6 1.4 0 1.8l-7.3 4.9c-.7.4-1.6-.1-1.6-.9z"/></svg></button>
          <div class="sticker" id="sticker"><div class="sticker-body"><img src={asset('sticker.svg')} alt="Namens-Sticker: Hello, my name is Clem!"></div><span class="sticker-flap" aria-hidden="true"></span></div>
        </div>

        <div class="tile t-text reveal" style="--i:1">
          <p class="big">{about.quote}</p>
          <p>{about.text}</p>
        </div>

        <div class="tile t-cv reveal" style="--i:2">
          <div class="cv-list">
            {about.cv.map((entry) => (
              <div class="cv-item">
                {entry.logo
                  ? <span class="cv-logo"><img src={asset(entry.logo)} alt={entry.logoAlt || ''}></span>
                  : <span class="cv-logo" aria-hidden="true"><svg><use href="#logo"/></svg></span>}
                <span class="cv-text"><small>{entry.period}</small><b>{entry.role}</b><span class="where">{entry.place}</span></span>
              </div>
            ))}
            <div class="cv-item">
              <span class="cv-logo more" aria-hidden="true">{about.cvMore}</span>
              <span class="cv-more"><a class="link" href="#cv" title="Eigene Seite, folgt">{about.cvLink}</a></span>
            </div>
          </div>
        </div>

        <div class="tile t-stat reveal" style="--i:3">
          <span class="num">{about.statNumber}</span>
          <p>{about.statText}</p>
        </div>

        <div class="tile t-skills reveal" style="--i:4">
          <div class="skills-copy">
            <h3>{about.skillsTitle}</h3>
            <p>{about.skillsText}</p>
            <a class="btn" href="#kontakt"><span class="btn-label">{about.skillsButton}</span><span class="btn-dot" aria-hidden="true"><svg><use href="#arrow"/></svg></span></a>
          </div>
          <button class="media-btn sheet-reset" type="button" id="sheet-reset" aria-label="Sticker zurücklegen" title="Sticker zurücklegen"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg></button>
          <ul class="sticker-sheet" id="sticker-sheet" aria-label="Schwerpunkte">
            <li class="skill" style="--w:110;--r:-7deg" data-x="58" data-y="66" aria-label="Branding"><svg aria-hidden="true" viewBox="0 0 110 46"><path d="M20 3H101a6 6 0 0 1 6 6V37a6 6 0 0 1-6 6H20L6 26Q3 23 6 20Z" fill="#FEC31E"/><circle cx="14" cy="23" r="3.5" fill="#fff"/><text x="63.5" y="27.2">Branding</text></svg></li>
            <li class="skill" style="--w:92;--r:-4deg" data-x="23" data-y="2" aria-label="Packaging Design"><svg aria-hidden="true" viewBox="0 0 92 146"><path d="M20 6L72 10V22L20 18Z" fill="#fff"/><path d="M4 48L20 18L72 22L56 54Z" fill="#FEC31E"/><path d="M56 54L72 22L88 46Z" fill="#fff"/><path d="M56 54L88 46V128L56 142Z" fill="#fff"/><path d="M4 48L56 54V142L4 132Z" fill="#fff"/><text x="30" y="95" transform="rotate(-90 30 95)" dy="4.2">Packaging</text></svg></li>
            <li class="skill" style="--w:74;--r:8deg" data-x="43" data-y="20" aria-label="UX / UI"><svg aria-hidden="true" viewBox="0 0 74 126"><rect x="3" y="3" width="68" height="120" rx="14" fill="#fff"/><line x1="30" y1="13" x2="44" y2="13"/><text x="37" y="67.2">UX / UI</text></svg></li>
            <li class="skill" style="--w:108;--r:-4deg" data-x="61" data-y="2" aria-label="Strategie"><svg aria-hidden="true" viewBox="0 0 108 108"><circle cx="54" cy="54" r="51" fill="#fff"/><circle cx="54" cy="54" r="39" fill="#FEC31E"/><text x="54" y="58.2">Strategie</text></svg></li>
            <li class="skill" style="--w:131;--r:-3deg" data-x="34" data-y="76" aria-label="Design Systems"><svg aria-hidden="true" viewBox="0 0 131 46"><rect x="3" y="3" width="125" height="40" rx="6" fill="#FEC31E"/><path d="M15 3v7M25 3v4M35 3v7M45 3v4M55 3v7M65 3v4M75 3v7M85 3v4M95 3v7M105 3v4M115 3v7" fill="none"/><text x="65.5" y="32.7">Design Systems</text></svg></li>
            <li class="skill" style="--w:112;--r:0deg" data-x="84" data-y="34" aria-label="Art Direction"><svg aria-hidden="true" viewBox="0 0 112 112"><circle cx="56" cy="56" r="52" fill="#222"/><text class="light" x="56" y="60.2">Art Direction</text></svg></li>
            <li class="skill" style="--w:140;--r:2deg" data-x="2" data-y="66" aria-label="Editorial Design"><svg aria-hidden="true" viewBox="0 0 140 75"><rect x="3" y="52" width="134" height="20" rx="4" fill="#222"/><rect x="9" y="30" width="122" height="22" rx="4" fill="#FEC31E"/><text x="70" y="45.2">Editorial Design</text><rect x="12" y="8" width="112" height="22" rx="4" fill="#fff" transform="rotate(-3 68 19)"/></svg></li>
            <li class="skill" style="--w:108;--r:-5deg" data-x="0" data-y="2" aria-label="User Research"><svg aria-hidden="true" viewBox="0 0 108 108"><line class="thick" x1="76" y1="76" x2="101" y2="101"/><circle cx="46" cy="46" r="42" fill="#fff"/><text x="46" y="42.7">User</text><text x="46" y="57.7">Research</text></svg></li>
          </ul>
        </div>
      </div>
      <div class="clients">
        <h3 class="clients-title reveal">{about.clientsTitle}</h3>
        <div class="marquee" id="marquee">
          <ul class="marquee-group">
            {about.clients.map((c) => <li><img src={asset(c.logo)} alt={c.name} style={`height:${c.height}px`} draggable="false"></li>)}
          </ul>
        </div>
      </div>
    </section>
