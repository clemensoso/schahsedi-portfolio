---
import site from '../data/site.json';

const units = Array.from({ length: 6 });
---
<footer data-nav="Contact">
  <div class="foot-band" role="img" aria-label={site.footerBand}>
    <div class="foot-track" aria-hidden="true">
      {[0, 1].map(() => <div class="foot-group">{units.map(() => <div class="foot-unit display"><svg aria-hidden="true"><use href="#logo"/></svg><span>{site.footerBand}</span></div>)}</div>)}
    </div>
  </div>
  <div class="foot">
    <span>© {site.copyright} <span id="foot-year">2026</span></span>
    <div class="foot-links">
      <a class="link" href="#start">{site.imprintLabel}</a>
      <a class="link" href="#start">{site.privacyLabel}</a>
    </div>
  </div>
</footer>
