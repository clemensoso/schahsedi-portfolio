---
// Emmy-Schriftzug: schreibt sich von links nach rechts, kurze Pause, Pfeil schnappt rein, Standbild,
// ausblenden, Schleife. Dazu ein ganz langsamer Zoom. Bewegung steckt in src/scripts/lettering.js.
const D = 'M651.543 243.462L560.32 185.344L433.188 213.272L313.727 239.82L313.78 240.685L481.56 262.306L491.16 255.876L556.685 22.6451L555.888 22.2901L470.847 144.089L470.054 143.796L476.374 27.6495L475.537 27.4055L398.592 169.918L397.755 169.674L418.884 26.8197L418.048 26.5911L345.597 175.951L344.762 175.723L364.281 30.3599L363.43 30.1477L297.359 178.563L296.509 178.351L315.156 33.4442L314.305 33.232L250.884 181.332L250.034 181.135L266.743 36.2371L265.893 36.0404L202.599 184.195L201.749 183.998L219.298 38.8939L218.448 38.6817L150.263 187.536L149.428 187.322L169.011 42.2502L168.161 42.038L102.052 199.561L68.9324 201.567L40.9869 75.4287L92.3959 32.9772L93.1429 33.2732L100.094 96.0465L21.4651 147.251';
// Punkte umdrehen, damit der Strich links beginnt
const n = D.match(/-?\d*\.?\d+/g).map(Number);
const pts = [];
for (let i = 0; i < n.length; i += 2) pts.push(`${n[i]} ${n[i + 1]}`);
const main = 'M' + pts.reverse().join('L');
---
<div class="lettering" style="--lt-bg:#EB3A00; --lt-fg:#FFFFFF" role="img" aria-label="Emmy-Schriftzug, animiert">
  <div class="lt-stage">
    <svg class="lt-obj" viewBox="0 0 686 290" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <g class="lt-cam">
        <path class="lt-main" d={main} stroke-width="31.0263" stroke-miterlimit="10" stroke-linecap="square"/>
        <path class="lt-arrow" d="M557.046 249.869L671.324 254.55L631.041 164.168" stroke-width="30.9665" stroke-linecap="square" stroke-linejoin="bevel"/>
      </g>
    </svg>
  </div>
</div>
