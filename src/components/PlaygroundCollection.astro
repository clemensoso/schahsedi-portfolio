---
// Übersicht aller Playground-Arbeiten (/playground/): Werkzeuge, Experimente, Bilder.
import CardStack from './CardStack.astro';
import WorkSwitch from './WorkSwitch.astro';
import pg from '../data/playground.json';
import { playgroundItems, playgroundTypes } from '../lib/playground.js';
---
<section class="listing" aria-labelledby="listing-title">
  <header class="wrap listing-head">
    <WorkSwitch active="playground" />
    <h1 class="display" id="listing-title">Playground</h1>
    <p>{pg.intro}</p>
    {playgroundTypes.length > 1 && (
      <div class="filter" role="group" aria-label="Nach Art filtern">
        <button type="button" class="filter-btn" data-filter="" aria-pressed="true">Alle</button>
        {playgroundTypes.map((t) => <button type="button" class="filter-btn" data-filter={t} aria-pressed="false">{t}</button>)}
      </div>
    )}
  </header>
  <ul class="wrap grid" id="listing-grid">
    {playgroundItems.map((it) => {
      const Tag = it.href ? 'a' : 'div';
      return (
        <li class="card" data-cats={JSON.stringify([it.type].filter(Boolean))}>
          <Tag class:list={['card-link', { 'is-static': !it.href }]} href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined}>
            <span class="card-media is-light"><CardStack images={[it.image, ...(it.images || [])]} pos={it.imagePos} /></span>
            <span class="card-text">
              {it.type && <span class="card-tag">{it.type}</span>}
              <b>{it.title}</b>
              {it.text && <small>{it.text}</small>}
            </span>
          </Tag>
        </li>
      );
    })}
  </ul>
  <p class="wrap listing-empty" id="listing-empty" hidden>Hier gibt es noch nichts.</p>
</section>

<script is:inline>(function () {
  var btns = document.querySelectorAll('.listing .filter-btn'), cards = document.querySelectorAll('#listing-grid .card');
  var empty = document.getElementById('listing-empty');
  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      var f = b.dataset.filter, shown = 0;
      btns.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      cards.forEach(function (c) { var on = !f || JSON.parse(c.dataset.cats).indexOf(f) >= 0; c.hidden = !on; if (on) shown++; });
      empty.hidden = shown > 0;
    });
  });
})();</script>
